  "item": [
    {
      "name": "Create new Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = pm.response.json()\r",
              "pm.collectionVariables.set(\"ITEM_ID\",response.Id);\r",
              "\r",
              "pm.test(\"Verificar Codigo Respuesta sea 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "pm.test(\"Verificar que el contenido del proyecto sea 'Nuevo Item de Prueba'\", function () {\r",
              "    pm.expect(response.Content).to.eql(\"Nuevo Item de Prueba\");\r",
              "})\r",
              "pm.test(\"Verificar Item Type\",function(){\r",
              "    pm.expect(response.ItemType).to.eql(1);\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"Content\":\"Nuevo Item de Prueba\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
